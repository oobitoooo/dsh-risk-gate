{
  "name": "dsh-risk-gate",
  "version": "1.3.1",
  "description": "dsh-purge 的野生补丁：给破甲加一道高危操作确认闸门（human-in-the-loop）。不改宿主、不撤销破甲、不联网，宿主升级后依然生效。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "policy",
    "docs",
    "examples",
    "README.md",
    "README.en.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node --check lib/index.js",
    "test": "node test/smoke.mjs",
    "livecheck": "node scripts/livecheck.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-purge",
    "purge-community",
    "jailbreak-guardrail",
    "human-in-the-loop",
    "approval",
    "guard",
    "safety"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oobitoooo/dsh-risk-gate.git"
  },
  "homepage": "https://github.com/oobitoooo/dsh-risk-gate#readme",
  "bugs": {
    "url": "https://github.com/oobitoooo/dsh-risk-gate/issues"
  },
  "license": "MIT"
}
