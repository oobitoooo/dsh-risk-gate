{
  "$comment": "示例配置。复制到 %USERPROFILE%\\.dsh\\risk-gate\\policy.json（或 $DSH_HOME/risk-gate/policy.json），改完保存即热读。",
  "ttlMs": 600000,
  "rules": [
    {
      "id": "R1",
      "label": "递归删除 / 格式化文件",
      "flags": "i",
      "pattern": "remove-item[^\\n]*-recurse|\\brm\\s+-rf\\b|\\brmdir\\s+/s|\\bdel\\s+/[fsq]|\\bformat-volume\\b|\\bclear-disk\\b|shutil\\.rmtree|\\bfs\\.(rm|rmdir)(sync)?\\s*\\(|rimraf",
      "risk": 8
    },
    {
      "id": "R2",
      "label": "写远端 / 改写仓库历史",
      "flags": "im",
      "pattern": "\\bgit\\s+push\\b|\\bgit\\s+reset\\s+--hard\\b|\\bgit\\s+clean\\s+-[a-z]*f|\\bgit\\s+remote\\s+(add|remove|set-url)\\b|\\bgh\\s+release\\s+(create|delete)\\b",
      "risk": 8
    },
    {
      "id": "R5",
      "label": "对外连接 / 数据外发 / 隧道",
      "flags": "i",
      "pattern": "\\b(ssh|scp|sftp|plink|ncat|socat|chisel|frpc|ngrok)\\b|\\bnc\\s+-|invoke-webrequest[^\\n]*(-method\\s+(post|put)|-body)",
      "risk": 9
    }
  ],
  "protectedRoots": [
    "c:\\windows",
    "c:\\program files",
    "c:\\programdata",
    "\\resources\\app",
    "\\.ssh",
    "\\.credentials"
  ],
  "recursiveDelete": {
    "allowRoots": [
      "C:\\path\\to\\your\\workspace"
    ],
    "maxEntries": 200,
    "useWorkdirAsRoot": false
  },
  "allow": [
    "^\\s*git\\s+(status|diff|log|show|branch|add|commit|fetch|switch)\\b",
    "^\\s*(ls|dir|pwd|cd)\\b",
    "^\\s*(get-content|get-childitem|select-string|test-path|get-item|get-process|get-service)\\b"
  ],
  "thresholds": {
    "block": 7,
    "warn": 4
  }
}
